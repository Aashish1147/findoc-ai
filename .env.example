# FinDoc AI Environment Configuration Example
# Copy this file to .env for local configuration

# LLM Provider Configuration
# LLM_PROVIDER accepts "mock" (default for development/testing without keys) or "gemini"
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Local Storage Configuration
FINDOC_DATA_DIR=./data

# File Ingestion Limits
FINDOC_MAX_FILE_MB=20
FINDOC_MAX_FILES_PER_UPLOAD=10

# Text Chunking Settings
FINDOC_CHUNK_SIZE=1000
FINDOC_CHUNK_OVERLAP=150

# Retrieval Configuration
FINDOC_TOP_K=5

# Local Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
